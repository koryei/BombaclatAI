# Copy this file to /etc/bombaclat/bombaclat.env and set permissions to 0640.
# Do not commit the populated file or paste these values into Discord.
DISCORD_TOKEN=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
SERPER_API_KEY=

OWNER_ID=1283126476463542375
COMMAND_PREFIX=!
DASHBOARD_ENABLED=false
LOG_LEVEL=INFO
LOG_PATH=/opt/bombaclat/data/bot.log
DB_PATH=/opt/bombaclat/data/bombaclat.db
CAPTCHA_STATE_PATH=/opt/bombaclat/data/captcha-blocked.json

VISION_ENABLED=true
GIFS_ENABLED=true
REACTIONS_ENABLED=true
AUTO_ACCEPT_FRIEND_REQUESTS=true
OWNER_REVIEW_MODE=off
SERPER_ENABLED=true
WEB_SEARCH_MODE=smart
AGENT_ENABLED=true
AGENT_OBSERVATION_ENABLED=true
AUTONOMOUS_PLANNER_ENABLED=true
AUTONOMY_MODE=autonomous
